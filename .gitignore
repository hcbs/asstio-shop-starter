# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Next.js rewrites these on every `next dev` / `next build` (AGENTS.md is its own agent rules,
# CLAUDE.md is a one-line include of it). Generated, version-specific, and not ours to commit.
/AGENTS.md
/CLAUDE.md
next-env.d.ts

# …but the example is committed.
!.env.example
