# The Storefront API. Locally: http://localhost:5041 with the backend's tools/Storefront.DevSeed run.
STOREFRONT_API_URL=https://api.storefront.asstio.com

# Publishable key (sfk_pub_…): safe in a browser bundle, though this app only calls the API from the server.
STOREFRONT_SITE_KEY=sfk_pub_...

# Preview key (sfk_prv_…): draft content. SERVER ONLY — never expose it, never prefix it NEXT_PUBLIC_.
STOREFRONT_PREVIEW_KEY=sfk_prv_...

# A secret of your own choosing, required by /api/draft?secret=… before draft mode turns on.
STOREFRONT_DRAFT_SECRET=change-me

# Market code; omit for the site's default market.
STOREFRONT_MARKET=se

# The <html lang> of the shell. The API picks content language from the market / Accept-Language.
STOREFRONT_LANGUAGE=sv
